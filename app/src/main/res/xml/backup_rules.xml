<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for pre-API 31 (fullBackupContent). API 31+ uses
   data_extraction_rules.xml instead — keep the two in sync.
   See https://developer.android.com/guide/topics/data/autobackup for details.

   STR-206: datastore/cloud_sync_prefs.json is install-scoped sync truth and
   must never be restored onto an install — a restore that brings it back
   alongside a stale Room database strands the fresh sign-in on that snapshot.
   The full rationale lives on CloudSyncPrefsRecord (core/data sync package).
   The Room database stays backed up on purpose; without the sync state it is
   wiped before use, and it remains the only backup copy for never-signed-in
   local data.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/cloud_sync_prefs.json" />
</full-backup-content>
