<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup / device-transfer rules. Pre-API 31 uses backup_rules.xml
   instead — keep the two in sync.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.

   STR-206: datastore/cloud_sync_prefs.json is install-scoped sync truth and
   must never survive a restore or a device transfer — the full rationale
   lives on CloudSyncPrefsRecord (core/data sync package) and in
   backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cloud_sync_prefs.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cloud_sync_prefs.json" />
    </device-transfer>
</data-extraction-rules>
