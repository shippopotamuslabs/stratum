# Copy to keystore.properties in the repo root (gitignored) and fill in secrets.
# Used by app/build.gradle.kts for signed release AAB/APK builds.
#
#   cp keystore.properties.example keystore.properties
#
# Paths are relative to the repo root.

storeFile=.keystore/stratum_keystore.jks
storePassword=REPLACE_ME
keyAlias=stratum_key
keyPassword=REPLACE_ME
