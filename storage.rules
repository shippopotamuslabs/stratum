rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Client uploads raw/sample exports; server writes script/slice/conversions via Admin SDK.
    match /imports/{userId}/{jobId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
