rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Client uploads raw/sample exports; server writes script/slice/conversions via Admin SDK.
    match /imports/{userId}/{jobId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Client uploads raw program-template files; server writes script/conversions via Admin SDK.
    match /programImports/{userId}/{jobId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // CP-SAT synthesis: client may only write request.json; worker (Admin SDK) writes result.json.
    // Soft 5 MiB cap on request writes matches MAX_REQUEST_BYTES on the Node side.
    match /synthesis/{userId}/{jobId}/request.json {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }
    match /synthesis/{userId}/{jobId}/result.json {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /synthesis/{userId}/{jobId}/{other=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
