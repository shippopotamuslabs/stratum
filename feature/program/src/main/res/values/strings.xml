    <string name="edit_workout_progression_scheme_linear">Linear</string>
    <string name="edit_workout_progression_scheme_double">Double</string>
    <string name="edit_workout_progression_scheme_info_content_description">About progression schemes</string>
    <string name="edit_workout_progression_scheme_sheet_title">Progression schemes</string>
    <string name="edit_workout_progression_scheme_linear_body">Linear adds weight each session when you hit the bottom of your rep range at the RIR target. Best for beginner gains or returning from a long layoff.</string>
    <string name="edit_workout_progression_scheme_double_body">Double progression holds weight until you reach the top of your rep range at the RIR target, then adds load. The default for experienced lifters.</string>
    <string name="edit_workout_progression_scheme_eligibility_body">Only compound lifts can use Linear. Isolation lifts always use Double progression.</string>
    <string name="edit_workout_progression_scheme_graduation_body">After two reset cycles on Linear, Stratum automatically moves the lift to Double progression.</string>
