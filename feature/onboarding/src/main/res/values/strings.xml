    <string name="gym_lifts_import_details_title">How import works</string>
    <string name="gym_lifts_import_details_ai">Every app exports differently. AI reads your file and builds a one-time mapper that converts your exercises, sets, and weights into Stratum\'s format — no manual spreadsheet work.</string>
